// social_cache.prisma
// ======================================================
// Cache for Apify social profile scrapes (24h TTL)
// ======================================================

model SocialScrapeCache {
  id        String   @id @default(uuid())
  platform  String
  handle    String
  data      Json
  found     Boolean  @default(true)
  reason    String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, handle])
  @@index([expiresAt])
  @@index([platform])
}