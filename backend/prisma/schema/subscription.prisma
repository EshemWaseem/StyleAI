// subscription.prisma 01-10
// ======================================================
// SUBSCRIPTION + PAYMENT — Role-aware SaaS
// Brands & Agencies: tied to organizationId
// Influencers: tied to userId
// ======================================================

model Subscription {
  id             String       @id @default(uuid())
  organizationId String?      @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---- Plan + Role ----
  role       BillingRole      @default(BRAND)
  planName   String           @default("trial")   // trial | starter | growth | studio | free | creator | pro | elite | solo | scale | enterprise
  status     SubscriptionStatus @default(ACTIVE)
  currency   String           @default("USD")

  // ---- Trial tracking ----
  isTrial      Boolean   @default(false)
  trialEndsAt  DateTime?

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  // ---- Stripe ----
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeStatus           String?
  stripeCurrentPeriodEnd DateTime?

  // ---- Generic billing metadata ----
  provider             PaymentProvider @default(STRIPE)
  billingCycle         BillingCycle?
  defaultPaymentMethod String?

  payments Payment[]
  usageCounters UsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([planName])
  @@index([role])
  @@index([provider])
  @@index([trialEndsAt])
}

model Payment {
  id             String       @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  description   String?

  provider PaymentProvider @default(STRIPE)
  context  PaymentContext  @default(SUBSCRIPTION)

  externalId            String?
  stripePaymentIntentId String?
  stripeInvoiceId       String?

  metadata Json?

  paidAt      DateTime?
  periodStart DateTime?
  periodEnd   DateTime?

  walletTransactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([provider])
  @@index([context])
  @@index([externalId])
}