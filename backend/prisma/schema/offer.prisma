// offer.prisma
// ======================================================
// CUSTOM OFFER — brand bundles items for an influencer
// Lifecycle (see enums.prisma for OfferStatus enum):
// DRAFT → PENDING → IN_PROGRESS → COMPLETED
//      (or DECLINED / EXPIRED / CANCELLED)
//
// Admin review lifecycle:
// DRAFT → PENDING_ADMIN → ADMIN_APPROVED → INFLUENCER_ACCEPTED
//      (or ADMIN_REJECTED / INFLUENCER_DECLINED)
// ======================================================

model CustomOffer {
  id String @id @default(uuid())

  brandId           String
  influencerId      String
  productId         String?
  createdByAgencyId String?

  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  influencer      Influencer    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdByAgency Organization? @relation("AgencyCreatedOffers", fields: [createdByAgencyId], references: [id], onDelete: SetNull)

  title String?

  items            Json
  subtotal         Decimal   @db.Decimal(12, 2)
  discountPct      Float
  discountAmount   Decimal   @db.Decimal(12, 2)
  adminFeePct      Float
  adminFee         Decimal   @db.Decimal(12, 2)
  total            Decimal   @db.Decimal(12, 2)
  escrowHeldAt     DateTime?
  escrowReleasedAt DateTime?
  currency         String

  status OfferStatus @default(DRAFT)

  brandNote      String?
  adminNote      String?
  influencerNote String?

  createdBy String
  creator   User   @relation("OfferCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  reviewedBy String?
  reviewer   User?     @relation("OfferReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  expiresAt DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]
  campaign           Campaign?

  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([status, createdAt])
  @@index([createdBy])
  @@index([reviewedBy])
  @@index([productId])
  @@index([createdByAgencyId])
}