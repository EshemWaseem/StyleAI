#      ==
# Backend — Production Environment Template
# Copy to backend/.env and fill in real values.
# NEVER commit .env — only this template.
#      ==

#  Database (internal docker network) 
DATABASE_URL=postgresql://styleai:CHANGE_ME@postgres:5432/styleai?schema=public


# ═══ SEED — ADMIN CREDENTIALS (used by `npm run seed:admin`) ═══
# Generate strong password: node -e "console.log(require('crypto').randomBytes(18).toString('base64'))"
SEED_ADMIN_EMAIL="admin@*******.com"
SEED_ADMIN_PASSWORD="*************"
SEED_ADMIN_NAME="Super Admin"


#  Server 
PORT=4000
NODE_ENV=production

#  JWT 
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_BYTE_HEX
JWT_EXPIRES_IN=7d

#  CORS 
FRONTEND_URL=https://your-domain.com

#  Email Verification (D1) 
# Set true to require email verification before login in production.
# Existing users are already migrated with emailVerified=true.
EMAIL_VERIFICATION_REQUIRED=true

#  AI Service 
AI_SERVICE_URL=http://ai-services:8000
AI_INTERNAL_KEY=CHANGE_ME_SHARED_SECRET_WITH_AI
AI_REQUEST_TIMEOUT_MS=600000

#  Redis / Queue 
REDIS_URL=redis://redis:6379
QUEUE_ENABLED=true
QUEUE_PREFIX=styleai

#  Cloudinary 
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

#  Public URLs 
API_BASE_URL=https://your-domain.com
WEBHOOK_BASE_URL=https://your-domain.com

#  Stripe 
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — one per plan tier and billing cycle.
# Replace <PLAN>_<CYCLE> with your actual plan names.
# Example: STARTER_MONTHLY, STARTER_YEARLY, PRO_MONTHLY, PRO_YEARLY
STRIPE_PRICE_<PLAN>_MONTHLY=price_...
STRIPE_PRICE_<PLAN>_YEARLY=price_...
# ... repeat for every plan tier (starter, pro, enterprise, etc.)

#  JazzCash 
JAZZCASH_MERCHANT_ID=...
JAZZCASH_PASSWORD=...
JAZZCASH_INTEGRITY_SALT=...
JAZZCASH_RETURN_URL=https://your-domain.com/api/webhooks/jazzcash

#  Easypaisa 
EASYPAISA_STORE_ID=...
EASYPAISA_HASH_KEY=...
EASYPAISA_RETURN_URL=https://your-domain.com/api/webhooks/easypaisa

#  COD 
COD_MIN_AMOUNT=500
COD_MAX_AMOUNT=200000
COD_AUTO_CONFIRM_DAYS=7

#  FX 
USD_PKR_RATE=278

#  Email (Gmail SMTP) 
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=StyleAI
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_ENABLED=true
ADMIN_EMAIL=your-email@gmail.com

#  Apify (influencer scraping) 
APIFY_TOKEN=apify_api_...
APIFY_USER_ID=your-apify-user-id

#  Smoke test admin (optional — remove if unused) 
SMOKE_ADMIN_EMAIL=smoke@your-domain.com
SMOKE_ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD