// user.prisma

// USER + ROLES + PERMISSIONS


model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  isActive Boolean @default(true)

  // Contact + location
  phone       String?
  country     String?
  countryCode String?

  // Login security / audit
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?

  // Password reset
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Email verification
  // @default(true) → existing users migrated as verified; new registrations set false explicitly
  emailVerified      Boolean   @default(true)
  emailVerifyToken   String?
  emailVerifyExpires DateTime?
  emailVerifySentAt  DateTime?

  // NEW (D3): token versioning for "logout all devices"
  // Incremented on /auth/logout-all → all older JWTs become invalid
  tokenVersion Int @default(0)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  userRoles   UserRole[]
  teamMembers TeamMember[]

  cart   Cart?
  orders Order[]

  joinRequests        BrandJoinRequest[] @relation("JoinRequests")
  joinReviews         BrandJoinRequest[] @relation("JoinReviews")
  sentInvitations     BrandInvitation[]  @relation("SentInvitations")
  receivedInvitations BrandInvitation[]  @relation("ReceivedInvitations")

  brandTeamMemberships BrandTeamMember[] @relation("BrandTeamMemberUser")
  brandTeamInvitesSent BrandTeamMember[] @relation("BrandTeamMemberInviter")

  influencerProfile Influencer?

  offersCreated    CustomOffer[]     @relation("OfferCreator")
  offersReviewed   CustomOffer[]     @relation("OfferReviewer")
  notifications    Notification[]
  campaignMessages CampaignMessage[] @relation("CampaignMessageSender")
  directMessages   DirectMessage[]   @relation("DirectMessageSender")
  wallet           Wallet?
  notificationPreference NotificationPreference?

  assistantConversations AssistantConversation[] @relation("AssistantConversations")

  subscription Subscription?

  // NEW (D2): login attempt history
  loginAttempts LoginAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([lockedUntil])
  @@index([passwordResetToken])
  @@index([emailVerifyToken])
}


// NEW (D2): Login attempt audit log
// Logs every attempt (success + fail). userId is null
// when the email doesn't match any user (failed for
// unknown emails is still recorded for security review).

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  reason    String? // SUCCESS | INVALID_CREDENTIALS | ACCOUNT_LOCKED | EMAIL_NOT_VERIFIED | PENDING_APPROVAL
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}