// ======================================================
// StyleAI — Prisma schema (main config)
// ======================================================
// All models live in sibling .prisma files in this folder.
// Prisma resolves all of them together.
// ======================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}