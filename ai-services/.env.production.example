# ======================================================
# AI Service — Production
# Copy to ai-services/.env and fill in
# ======================================================

AI_ENV=production
DEBUG=false

APP_NAME=StyleAI AI
APP_VERSION=1.0.0

# ---- Internal auth ----
INTERNAL_KEY=CHANGE_ME_SHARED_SECRET_WITH_BACKEND

# ---- LLM Provider ----
# Options: ollama | groq | gemini
LLM_PROVIDER=groq

# ---- Ollama (if using local) ----
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava:7b

# ---- Groq (free tier, recommended for prod) ----
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# ---- Gemini ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Image generation ----
IMAGE_PROVIDER=hf
HF_API_TOKEN=hf_...
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# ---- Vision provider ----
VISION_PROVIDER=gemini