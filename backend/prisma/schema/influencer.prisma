// influencer.prisma
// ======================================================
// INFLUENCER — global pool, optionally linked to a User
// ======================================================

model Influencer {
  id String @id @default(uuid())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  username    String  @unique
  slug        String  @unique
  bio         String?
  avatarUrl   String?

  email String?
  phone String?

  country  String?
  city     String?
  language String?
  gender   String?
  ageGroup String?

  followerCount  Int   @default(0)
  followingCount Int   @default(0)
  engagementRate Float @default(0)

  categories        String[]
  audienceFavorites String[] // ["Shahid Afridi", "Sara Khan", ...]

  avgViews    Int @default(0)
  avgLikes    Int @default(0)
  avgComments Int @default(0)

  pricePerPost Decimal? @db.Decimal(10, 2)

  // ----------------------------------------------
  // Pricing — influencer-owned, no system defaults
  // ----------------------------------------------
  // Nullable on purpose: the influencer explicitly opts in.
  // System NEVER pre-fills these values.
  minBudget      Decimal? @db.Decimal(10, 2) // floor price; null = no floor
  acceptsBundles Boolean? // null = not asked yet; true/false = explicit

  currency     String                 @default("USD")
  availability InfluencerAvailability @default(AVAILABLE)
  status       InfluencerStatus       @default(ACTIVE)

  // Per-platform, per-content-type pricing.
  // Shape: { "INSTAGRAM": { "post": 150, "reel": 300 }, "TIKTOK": { "video": 250 } }
  // Only entries the influencer actually offers are stored — nothing auto-filled.
  pricingTiers Json?
  portfolio    Json?

  fashionScore   Float?
  luxuryScore    Float?
  beautyScore    Float?
  lifestyleScore Float?

  profileCompleted Boolean @default(false)

  // ----------------------------------------------
  // Relations
  // ----------------------------------------------
  socialAccounts  InfluencerSocialAccount[]
  audienceMetrics InfluencerAudienceMetrics?
  savedByOrgs     OrganizationInfluencer[]
  offers          CustomOffer[] // offers targeting this influencer
  listings        InfluencerListing[] // public listings by this influencer
  campaigns       Campaign[]
  // conversations   Conversation[]
  wallet          Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([country])
  @@index([availability])
  @@index([followerCount])
  @@index([engagementRate])
}

model InfluencerSocialAccount {
  id             String             @id @default(uuid())
  influencerId   String
  platform       InfluencerPlatform
  platformCustom String? // for OTHER (e.g. "Pinterest", "GitHub")
  handle         String
  profileUrl     String?
  followerCount  Int                @default(0)
  followingCount Int                @default(0)
  engagementRate Float              @default(0)
  isPrimary      Boolean            @default(false)

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([influencerId, platform, handle])
  @@index([influencerId])
  @@index([platform])
}

model InfluencerAudienceMetrics {
  id                 String   @id @default(uuid())
  influencerId       String   @unique
  ageDistribution    Json?
  genderDistribution Json?
  topCountries       Json?
  interests          String[]
  audienceQuality    Float?
  fakeFollowerPct    Float?

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model OrganizationInfluencer {
  id             String   @id @default(uuid())
  organizationId String
  influencerId   String
  savedAt        DateTime @default(now())
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  influencer   Influencer   @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, influencerId])
  @@index([organizationId])
  @@index([influencerId])
}

