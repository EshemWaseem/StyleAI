#      ==
# StyleAI Backend — .gitignore
#      ==

#  ENVIRONMENT & SECRETS 
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep templates (explicitly allow)
!.env.example
!.env.production.example
!.env.example.production

#  DEPENDENCIES 
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

#  BUILD OUTPUT 
dist/
build/
out/
.next/
.cache/
coverage/

#  PRISMA (generated) 
node_modules/.prisma/
node_modules/@prisma/client/
.prisma-client/

#  LOGS 
logs/
*.log
!npm-debug.log*

#  OS FILES 
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

#  IDE / EDITORS 
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

#  TEMP / JUNK FILES 
*.tmp
*.temp
*~
utputFormat
*.bak
*.orig

#      ==
# TEST PAYLOADS (may contain credentials)
#      ==
/login.json
/register.json

#      ==
# DATABASE BACKUPS & TEMP SQL (real data dumps)
#      ==
/backup_*.sql
/backup_before_*.sql
/check.sql
/check_*.sql
/add_lockout_columns.sql
*.sql.bak
*.sql.orig

#      ==
# SCHEMA BACKUPS
#      ==
prisma/schema.prisma.backup
*.prisma.backup
prisma/schema/*.backup

#      ==
# ROOT-LEVEL TEST SCRIPTS (already deleted, but safe)
#      ==
/reset_password.js
/test-cloudinary.js
/test-sse.js
scripts/
#      ==
# OPS / DEBUG SCRIPTS FOLDER
#      ==
/scripts/

#      ==
# DOCKER OVERRIDES
#      ==
docker-compose.override.yml

#      ==
# MISC
#      ==
*.pid
*.seed
*.pid.lock


login.json
register.json

